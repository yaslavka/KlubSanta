# ---------- Klub Santa environment ----------
# Database (SQLite for local dev; to move to Supabase Postgres change provider in
# prisma/schema.prisma to "postgresql" and point DATABASE_URL to Supabase)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin session JWT secret (change in production!)
SESSION_SECRET=ks-dev-session-secret-2f8c41a9b7e64d0f

# Default admin (used by prisma/seed.ts)
ADMIN_EMAIL=admin@klubsanta.com
ADMIN_PASSWORD=KlubSanta2026!

# Public app URL (used in emails / Stripe redirects)
APP_URL=http://localhost:3000

# ---------- Providers: add keys to activate live channels ----------
# Stripe (Hosted Checkout + signed webhooks)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Transactional email (Resend)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Klub Santa <hello@klubsanta.com>

# HeyGen (personalized video rendering)
# HEYGEN_API_KEY=xxx
# HEYGEN_SANTA_AVATAR_ID=xxx
# HEYGEN_SANTA_VOICE_ID=xxx
# HEYGEN_WEBHOOK_SECRET=xxx
# HEYGEN_MODE=test
