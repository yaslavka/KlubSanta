# ─────────────────────────────────────────────────────────────────────────────
# Klub Santa — environment configuration
# Copy to .env (local) or paste into Vercel Project → Settings → Environment.
# Payment mode is derived from the presence/prefix of STRIPE_SECRET_KEY:
#
#   STRIPE_SECRET_KEY unset            → SANDBOX  (built-in test checkout, no keys needed)
#   STRIPE_SECRET_KEY=sk_test_…        → STRIPE TEST (real Stripe, test cards, no real money)
#   STRIPE_SECRET_KEY=sk_live_…        → STRIPE LIVE  (battle mode, real charges)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./db/custom.db"
# Supabase Postgres (migration path from the technical brief):
# 1) set provider = "postgresql" in prisma/schema.prisma
# 2) swap DATABASE_URL, 3) run: bun run db:push
# DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ── Payments (Stripe Hosted Checkout — per technical brief) ───────────────────
# SANDBOX MODE (default): leave both unset. A branded built-in test gateway at
#   /checkout/sandbox processes test payments (4242… succeeds, 4000…0002
#   declines) through the real fulfillment pipeline.
# TEST MODE: create keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_51Abc...
# LIVE MODE: keys at https://dashboard.stripe.com/apikeys — battle mode.
# STRIPE_SECRET_KEY=sk_live_51Abc...
#
# Signed webhook endpoint (source of truth in production):
#   Endpoint URL:  https://YOUR-DOMAIN/api/webhooks/stripe
#   Events: checkout.session.completed, checkout.session.expired,
#           checkout.session.async_payment_failed, charge.refunded
#   Signing secret (whsec_…) from the webhook endpoint you register:
# STRIPE_WEBHOOK_SECRET=whsec_...
# Notes: without a webhook secret, payments are still verified and fulfilled
# on return via POST /api/checkout/confirm (idempotent with the webhook).

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin used for checkout success/cancel redirects, email links,
# canonical URLs, OpenGraph/Twitter tags, sitemap.xml and robots.txt.
APP_URL="http://localhost:3000"
# Signs admin sessions and sandbox payment tokens — REQUIRED in production.
# Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Email (Resend — per technical brief) ──────────────────────────────────────
# Without a key, emails are composed and logged (EmailLog) but not delivered.
# RESEND_API_KEY=re_...
EMAIL_FROM="Klub Santa <letters@klubsanta.com>"

# ── AI video provider (HeyGen — per technical brief) ──────────────────────────
# Without a key, paid bookings queue a durable GenerationJob that dispatches
# automatically once the key appears (restart included).
# HEYGEN_API_KEY=...
# Santa avatar/voice from your HeyGen account:
# HEYGEN_SANTA_AVATAR_ID=...
# HEYGEN_SANTA_VOICE_ID=...
# HeyGen webhook secret (endpoint: /api/webhooks/heygen)
# HEYGEN_WEBHOOK_SECRET=...

# ── Seed admin (created only on the first seed run; DB, not env, is the source) ─
# ADMIN_EMAIL="admin@klubsanta.com"
# ADMIN_PASSWORD="KlubSanta2026!"
